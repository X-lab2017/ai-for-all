[
  {
    "start": 0.7227272727272728,
    "end": 2.9411067193675895,
    "text": "让 AI 用得起，更用得好！"
  },
  {
    "start": 2.9411067193675895,
    "end": 5.824999999999999,
    "text": "让每个人，都有创造未来的机会。"
  },
  {
    "start": 8.272727272727272,
    "end": 11.545454545454543,
    "text": "三十五年，Linux 让我们看见：开放协作，"
  },
  {
    "start": 11.545454545454543,
    "end": 13.193181818181817,
    "text": "能够创造共同的基础。"
  },
  {
    "start": 16.272727272727273,
    "end": 19.91287878787879,
    "text": "今天，Qwen、DeepSeek、GLM、Kimi 与混元，"
  },
  {
    "start": 19.91287878787879,
    "end": 21.80681818181818,
    "text": "正打开更多创造的可能。"
  },
  {
    "start": 25.26574124478316,
    "end": 26.80645921595544,
    "text": "开源，降低门槛。"
  },
  {
    "start": 26.80645921595544,
    "end": 28.60396351565643,
    "text": "开发者，放大创造！"
  },
  {
    "start": 28.60396351565643,
    "end": 31.171826800943563,
    "text": "让技术，走进真实的生活。"
  },
  {
    "start": 33.269713711702664,
    "end": 36.02074825846746,
    "text": "把创造变成共享的数字公共品。"
  },
  {
    "start": 36.02074825846746,
    "end": 40.0486564540432,
    "text": "让开放的成果，经过维护与采用，成为真正的帮助。"
  },
  {
    "start": 42.27272727272727,
    "end": 44.96280991735538,
    "text": "让贡献被看见，让支持有依据！"
  },
  {
    "start": 44.96280991735538,
    "end": 48.67045454545455,
    "text": "用数据与评价，让每一步行动经得起检验。"
  },
  {
    "start": 51.27272727272727,
    "end": 54.259297520661164,
    "text": "让贡献带来成长，让投入支持创造。"
  },
  {
    "start": 54.259297520661164,
    "end": 57.522727272727266,
    "text": "用数据与评价连接双轮，让每一次行动，"
  },
  {
    "start": 57.522727272727266,
    "end": 59.06818181818182,
    "text": "都推动下一次前进！"
  },
  {
    "start": 63.27272727272727,
    "end": 65.48863636363636,
    "text": "从 OpenDigger、OpenRank 到 OpenShare，"
  },
  {
    "start": 65.48863636363636,
    "end": 68.61363636363636,
    "text": "把愿景落到实践，用行动检验承诺。"
  },
  {
    "start": 71.26512548162033,
    "end": 74.843552677667,
    "text": "分享一个需要，贡献一个工具，开放一个场景。"
  },
  {
    "start": 74.843552677667,
    "end": 76.25315005727377,
    "text": "改变，就从我们开始！"
  },
  {
    "start": 78.27272727272727,
    "end": 81.4301948051948,
    "text": "让技术成为机会，让创造惠及更多人。"
  },
  {
    "start": 81.4301948051948,
    "end": 83.27020202020202,
    "text": "加入 X-lab AI。"
  },
  {
    "start": 83.27020202020202,
    "end": 85.25,
    "text": "现在，就一起行动！"
  }
]